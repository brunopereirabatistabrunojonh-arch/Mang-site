<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mang-site - Leia Mangás Online</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }
        
        header {
            background: rgba(0, 0, 0, 0.8);
            padding: 1rem 2rem;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        header h1 {
            font-size: 1.8rem;
            color: #667eea;
        }
        
        nav a {
            color: white;
            text-decoration: none;
            margin-left: 2rem;
            transition: color 0.3s;
        }
        
        nav a:hover {
            color: #667eea;
        }
        
        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }
        
        .search-box {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .search-box form {
            display: flex;
            gap: 1rem;
        }
        
        .search-box input {
            flex: 1;
            padding: 0.8rem;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }
        
        .search-box button {
            padding: 0.8rem 2rem;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s;
        }
        
        .search-box button:hover {
            background: #764ba2;
        }
        
        .manga-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 2rem;
        }
        
        .manga-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
        }
        
        .manga-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }
        
        .manga-cover {
            width: 100%;
            height: 250px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
        }
        
        .manga-info {
            padding: 1rem;
        }
        
        .manga-title {
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
            color: #333;
        }
        
        .manga-author {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.5rem;
        }
        
        .manga-chapters {
            font-size: 0.85rem;
            color: #999;
        }
        
        .manga-genre {
            background: #667eea;
            color: white;
            padding: 0.3rem 0.6rem;
            border-radius: 3px;
            font-size: 0.8rem;
            display: inline-block;
            margin-top: 0.5rem;
        }
        
        .no-manga {
            text-align: center;
            background: white;
            padding: 3rem;
            border-radius: 10px;
            color: #666;
        }
        
        .auth-links {
            display: flex;
            gap: 1rem;
        }
        
        .auth-links a {
            padding: 0.5rem 1rem;
            background: #667eea;
            border-radius: 5px;
            transition: background 0.3s;
        }
        
        .auth-links a:hover {
            background: #764ba2;
        }
        
        .user-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <header>
        <h1>📚 Mang-site</h1>
        <nav>
            <% if (currentUser) { %>
                <div class="user-menu">
                    <a href="/dashboard">Dashboard</a>
                    <a href="/library">Biblioteca</a>
                    <a href="/notifications">Notificações</a>
                    <a href="/profile/<%= currentUser.username %>">
                        <div class="avatar" style="background-color: <%= currentUser.avatar_color %>;">
                            <%= currentUser.username.charAt(0).toUpperCase() %>
                        </div>
                    </a>
                    <form method="POST" action="/logout" style="display: inline;">
                        <button type="submit" style="background: none; border: none; color: white; cursor: pointer; text-decoration: underline;">Sair</button>
                    </form>
                </div>
            <% } else { %>
                <div class="auth-links">
                    <a href="/login">Login</a>
                    <a href="/register">Cadastro</a>
                </div>
            <% } %>
        </nav>
    </header>
    
    <div class="container">
        <div class="search-box">
            <form method="GET" action="/">
                <input type="text" name="q" placeholder="Buscar por título ou gênero..." value="<%= q %>">
                <button type="submit">Buscar</button>
            </form>
        </div>
        
        <% if (flash && flash.error) { %>
            <div style="background: #fee; color: #c33; padding: 1rem; border-radius: 5px; margin-bottom: 1rem;">
                <%= flash.error %>
            </div>
        <% } %>
        
        <% if (flash && flash.info) { %>
            <div style="background: #efe; color: #3c3; padding: 1rem; border-radius: 5px; margin-bottom: 1rem;">
                <%= flash.info %>
            </div>
        <% } %>
        
        <% if (currentUser) { %>
            <div style="text-align: center; margin-bottom: 2rem;">
                <a href="/manga/new" style="background: #667eea; color: white; padding: 0.8rem 2rem; border-radius: 5px; text-decoration: none; display: inline-block;">
                    + Criar Novo Mangá
                </a>
            </div>
        <% } %>
        
        <% if (mangaList && mangaList.length > 0) { %>
            <div class="manga-grid">
                <% mangaList.forEach(manga => { %>
                    <a href="/manga/<%= manga.slug %>" style="text-decoration: none; color: inherit;">
                        <div class="manga-card">
                            <div class="manga-cover">
                                <% if (manga.cover_path) { %>
                                    <img src="<%= manga.cover_path %>" style="width: 100%; height: 100%; object-fit: cover;" alt="<%= manga.title %>">
                                <% } else { %>
                                    📖
                                <% } %>
                            </div>
                            <div class="manga-info">
                                <div class="manga-title"><%= manga.title %></div>
                                <div class="manga-author">Por: <%= manga.author_username %></div>
                                <div class="manga-chapters"><%= manga.chapter_count %> capítulo(s)</div>
                                <% if (manga.genre) { %>
                                    <div class="manga-genre"><%= manga.genre %></div>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-manga">
                <h2>Nenhum mangá encontrado</h2>
                <p>Comece a explorar ou crie seu próprio mangá!</p>
            </div>
        <% } %>
    </div>
</body>
</html>
